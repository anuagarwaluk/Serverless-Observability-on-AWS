import json
import boto3
import uuid
import time
from datetime import datetime
import logging
import os
from aws_xray_sdk.core import xray_recorder
from aws_xray_sdk.core import patch_all

# Patch AWS SDK calls for X-Ray tracing
patch_all()

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

dynamodb = boto3.resource('dynamodb')
cloudwatch = boto3.client('cloudwatch')
table = dynamodb.Table(os.environ['TABLE_NAME'])

def lambda_handler(event, context):
    request_id = context.aws_request_id
    
    logger.info(f"Processing request", extra={
        'request_id': request_id,
        'method': event.get('httpMethod'),
        'path': event.get('path')
    })
    
    try:
        method = event.get('httpMethod')
        path = event.get('path', '')
        
        if method == 'GET' and path == '/data':
            return get_all_data(request_id)
        elif method == 'POST' and path == '/data':
            return create_data(event, request_id)
        elif method == 'PUT' and path.startswith('/data/'):
            item_id = path.split('/')[-1]
            return update_data(event, item_id, request_id)
        elif method == 'DELETE' and path.startswith('/data/'):
            item_id = path.split('/')[-1]
            return delete_data(item_id, request_id)
        else:
            return create_response(404, {'error': 'Not found'}, request_id)
            
    except Exception as e:
        logger.error(f"Error processing request", extra={
            'request_id': request_id,
            'error': str(e)
        })
        publish_metric('ErrorCount', 1)
        return create_response(500, {'error': 'Internal server error'}, request_id)

def get_all_data(request_id):
    """Get all data items"""
    start_time = time.time()
    response = table.scan()
    scan_time = (time.time() - start_time) * 1000
    
    logger.info(f"Retrieved {response['Count']} items", extra={
        'request_id': request_id,
        'scan_time_ms': scan_time
    })
    
    publish_metric('DataRetrieved', response['Count'])
    return create_response(200, {'items': response['Items']}, request_id)

def create_data(event, request_id):
    """Create new data item"""
    body = json.loads(event.get('body', '{}'))
    
    # Validate required fields
    if not body.get('name') or not body.get('value'):
        return create_response(400, {'error': 'Name and value are required'}, request_id)
    
    item = {
        'id': str(uuid.uuid4()),
        'name': body['name'],
        'value': body['value'],
        'created_at': datetime.utcnow().isoformat(),
        'updated_at': datetime.utcnow().isoformat()
    }
    
    # Simulate some processing time
    time.sleep(0.1)
    
    start_time = time.time()
    table.put_item(Item=item)
    write_time = (time.time() - start_time) * 1000
    
    logger.info(f"Created new item", extra={
        'request_id': request_id,
        'item_id': item['id'],
        'write_time_ms': write_time
    })
    
    publish_metric('DataCreated', 1)
    return create_response(201, {'item': item}, request_id)

def update_data(event, item_id, request_id):
    """Update existing data item"""
    body = json.loads(event.get('body', '{}'))
    
    # Check if item exists first
    start_time = time.time()
    try:
        response = table.get_item(Key={'id': item_id})
        get_time = (time.time() - start_time) * 1000
        
        if 'Item' not in response:
            return create_response(404, {'error': 'Item not found'}, request_id)
        
        # Update the item
        update_expression = 'SET updated_at = :updated'
        expression_values = {':updated': datetime.utcnow().isoformat()}
        
        if body.get('name'):
            update_expression += ', #name = :name'
            expression_values[':name'] = body['name']
        
        if body.get('value'):
            update_expression += ', #value = :value'
            expression_values[':value'] = body['value']
        
        start_time = time.time()
        table.update_item(
            Key={'id': item_id},
            UpdateExpression=update_expression,
            ExpressionAttributeNames={'#name': 'name', '#value': 'value'} if body.get('name') or body.get('value') else {},
            ExpressionAttributeValues=expression_values,
            ReturnValues='ALL_NEW'
        )
        update_time = (time.time() - start_time) * 1000
        
        logger.info(f"Updated item", extra={
            'request_id': request_id,
            'item_id': item_id,
            'update_time_ms': update_time
        })
        
        publish_metric('DataUpdated', 1)
        return create_response(200, {'message': 'Item updated successfully'}, request_id)
        
    except Exception as e:
        logger.error(f"Error updating item", extra={
            'request_id': request_id,
            'item_id': item_id,
            'error': str(e)
        })
        return create_response(500, {'error': 'Failed to update item'}, request_id)

def delete_data(item_id, request_id):
    """Delete data item with X-Ray subsegment demonstration"""
    start_time = time.time()
    try:
        # Create X-Ray subsegment for the slow operation
        with xray_recorder.in_subsegment('delete_validation_process') as subsegment:
            subsegment.put_annotation('operation', 'delete_validation')
            subsegment.put_metadata('item_id', item_id)
            subsegment.put_metadata('student_learning', 'This 5-second delay demonstrates X-Ray subsegment timing')
            
            logger.info(f"Starting delete validation process", extra={
                'request_id': request_id,
                'item_id': item_id
            })
            
            # INTENTIONAL DELAY: Simulate slow validation/cleanup process
            # Students will learn to identify this bottleneck using X-Ray traces
            # TODO: Remove this 5-second delay to improve performance!
            time.sleep(5)
            
            subsegment.put_annotation('validation_complete', True)
            subsegment.put_annotation('delay_seconds', 5)
        
        # Create another subsegment for the actual delete operation
        with xray_recorder.in_subsegment('dynamodb_delete') as subsegment:
            subsegment.put_annotation('operation', 'dynamodb_delete')
            subsegment.put_metadata('table_name', os.environ['TABLE_NAME'])
            
            table.delete_item(Key={'id': item_id})
            subsegment.put_annotation('delete_success', True)
        
        delete_time = (time.time() - start_time) * 1000
        
        logger.info(f"Deleted item", extra={
            'request_id': request_id,
            'item_id': item_id,
            'delete_time_ms': delete_time
        })
        
        publish_metric('DataDeleted', 1)
        return create_response(200, {'message': 'Item deleted successfully'}, request_id)
        
    except Exception as e:
        logger.error(f"Error deleting item", extra={
            'request_id': request_id,
            'item_id': item_id,
            'error': str(e)
        })
        return create_response(500, {'error': 'Failed to delete item'}, request_id)

def publish_metric(metric_name, value):
    """Publish custom metrics to CloudWatch"""
    try:
        cloudwatch.put_metric_data(
            Namespace='Observability/DataApp',
            MetricData=[
                {
                    'MetricName': metric_name,
                    'Value': value,
                    'Unit': 'Count',
                    'Dimensions': [
                        {
                            'Name': 'Function',
                            'Value': os.environ.get('AWS_LAMBDA_FUNCTION_NAME', 'DataFunction')
                        }
                    ]
                }
            ]
        )
    except Exception as e:
        logger.error(f"Failed to publish metric {metric_name}: {str(e)}")

def create_response(status_code, body, request_id):
    """Create standardized API response with CORS headers"""
    return {
        'statusCode': status_code,
        'headers': {
            'Content-Type': 'application/json',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET,POST,PUT,DELETE,OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token',
            'X-Request-ID': request_id
        },
        'body': json.dumps(body)
    }

